# Personal Trainer Bot proxy (Phase 7). Copy to `.env` and fill in.
# EXPO_PUBLIC_* vars are inlined into the app JS bundle at build time (restart Metro after edits).
# When these are unset, the trainer chat + insights fall back to the on-device mock — dev works
# with zero setup. See server/trainer-proxy/README.md for how to deploy the Worker.

# The deployed Worker's /chat endpoint, e.g. https://trainer-proxy.<subdomain>.workers.dev/chat
EXPO_PUBLIC_TRAINER_PROXY_URL=

# Must match the APP_ACCESS_TOKEN secret set on the Worker (`wrangler secret put APP_ACCESS_TOKEN`).
# This is a SOFT gate only — it ships in the app bundle. The real secret (the OpenAI key) lives
# only in the Worker.
EXPO_PUBLIC_TRAINER_PROXY_TOKEN=
